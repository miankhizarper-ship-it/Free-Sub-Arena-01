# =============================================================================
# FreeSub SaaS Platform - Environment Configuration Example
# Copy this file to `.env` and fill in your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="FreeSub"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# MySQL 8+ Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freesub
DB_USER=freesub_user
DB_PASS=your_secure_database_password
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# Clerk Authentication (Session JWT & JWKS Verification)
# -----------------------------------------------------------------------------
# Clerk Frontend API / Issuer URL (e.g., https://your-instance.clerk.accounts.dev)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Clerk JWKS Endpoint URL (defaults to ${CLERK_ISSUER}/.well-known/jwks.json)
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional Clerk Publishable & Secret Keys (Secret key enables Backend API profile fallback)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional comma-separated list of allowed `azp` origins (leave empty to allow any)
CLERK_AUTHORIZED_PARTIES=http://localhost:8000

# Local JWKS cache lifetime and clock skew leeway (in seconds)
CLERK_JWKS_CACHE_TTL=3600
CLERK_CLOCK_LEEWAY=60

# -----------------------------------------------------------------------------
# Desktop / Local Admin Security
# -----------------------------------------------------------------------------
ADMIN_LOCAL_PASSCODE=change-this-strong-admin-passcode
ADMIN_ALLOW_REMOTE=false

# -----------------------------------------------------------------------------
# Cloudflare REST API v4 & Default Subdomain Provisioning
# Note: Per-domain Zone IDs and API Tokens are stored in the `root_domains` table.
# -----------------------------------------------------------------------------
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TIMEOUT=15
DEFAULT_PLACEHOLDER_IP=192.0.2.1
DEFAULT_PLACEHOLDER_PROXIED=true

# -----------------------------------------------------------------------------
# API CORS Settings (comma-separated origins, or `*` for public/same-origin)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
